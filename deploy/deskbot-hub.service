# systemd：开机自启、挂了自动重启。日志：journalctl -u deskbot-hub -f
[Unit]
Description=DeskBot hub (WebSocket 127.0.0.1:8765 behind nginx)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/deskbot
Environment=PYTHONUTF8=1
ExecStart=/home/ubuntu/deskbot/.venv/bin/python hub/mock_hub.py --proxy
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
